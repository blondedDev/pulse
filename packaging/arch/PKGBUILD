# Maintainer: Aleksandr Popov <blondedDev@users.noreply.github.com>
#
# Pulse, installed the way it is published: the self-contained AppImage, placed
# in its own folder under the user's Applications directory. That folder is the
# whole install — the image, its `data/` beside it, nothing in ~/.config or
# ~/.local/share — so removing the folder removes Pulse. The launcher and menu
# entry are package-owned; the AppImage is user-owned, so Pulse's updater
# replaces it in place.
#
# It is listed in `backup` on purpose: an upgrade must not clobber an AppImage
# the app has already updated. pacman leaves a `.pacnew` if the packaged version
# is newer.
#
# After a new release: bump pkgver, refresh sha256sums (`updpkgsums` while in
# this directory), then `makepkg -f`.
pkgname=pulse-appimage
pkgver=5.9.0
pkgrel=1
pkgdesc="Local-first music player, packaged as its self-contained AppImage"
arch=('x86_64')
url="https://github.com/blondedDev/pulse"
license=('MIT')
depends=('fuse2')
# An AppImage is an ELF with a squashfs appended. `strip` would rewrite the ELF
# and corrupt the payload, so it stays out of this one.
options=('!strip' '!debug')
source=(
    "Pulse-${pkgver}-x86_64.AppImage::https://github.com/blondedDev/pulse/releases/download/v${pkgver}/Pulse-v${pkgver}-x86_64.AppImage"
    "pulse.png::https://raw.githubusercontent.com/blondedDev/pulse/v${pkgver}/crates/ui_resources/assets/app-icon/256x256.png"
    "pulse.desktop"
    "pulse"
)
sha256sums=('c3acb64017c0ef646cecef8abaee5a6a368e7a5bb030c80c2f69878e37cd5d6c'
            '09dcb2c15812df6a4501667132cb75ad31a62c59e520d160a70d008b8299b9ed'
            '0ef2b955cd421f6cdfa8a8d288510ad98e950478cd4b02ee51a78602171fa632'
            '02ccb3583df65b417d1bb1578974582f2664e288e44f78240dd89ec9a370750b')
backup=('home/blonded/Applications/Pulse/Pulse.AppImage')

package() {
    # The AppImage goes in the user's folder, not /opt: it is writable by them,
    # which is what lets the in-app updater replace it, and Pulse keeps its
    # library in `data/` beside it.
    install -Dm755 "$srcdir/Pulse-${pkgver}-x86_64.AppImage" \
        "$pkgdir/home/blonded/Applications/Pulse/Pulse.AppImage"
    chown -R 1000:1000 "$pkgdir/home/blonded"

    install -Dm755 "$srcdir/pulse" "$pkgdir/usr/bin/pulse"
    ln -s pulse "$pkgdir/usr/bin/pulse-appimage"
    install -Dm644 "$srcdir/pulse.desktop" "$pkgdir/usr/share/applications/pulse.desktop"
    install -Dm644 "$srcdir/pulse.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/pulse.png"
}
