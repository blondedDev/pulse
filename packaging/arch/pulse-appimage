#!/bin/sh
# Launch Pulse, from a copy its own updater can replace.
#
# The package owns /opt/pulse/Pulse.AppImage (the seed): root-owned, never
# touched after install, so pacman's file record stays honest. Pulse's updater
# cannot write there, so the first launch copies the seed to
#
#   ${XDG_DATA_HOME:-$HOME/.local/share}/pulse-appimage/Pulse.AppImage
#
# and runs that copy. The AppImage runtime exports its path as APPIMAGE, so the
# updater finds the writable file and replaces it in place.
#
# A package upgrade replaces the seed; its id changes, and the copy is refreshed
# on the next launch. That keeps `paru -Syu pulse-appimage` working as the
# other way to update.
set -eu

seed=/opt/pulse/Pulse.AppImage
data="${XDG_DATA_HOME:-$HOME/.local/share}/pulse-appimage"
dest="$data/Pulse.AppImage"
marker="$data/seed-id"

seed_id="$(stat -c '%s:%Y' -- "$seed")"
copied_id="$(cat -- "$marker" 2>/dev/null || true)"

if [ ! -f "$dest" ] || [ "$copied_id" != "$seed_id" ]; then
    if mkdir -p -- "$data" &&
        cp -- "$seed" "$dest.new.$$" &&
        chmod 755 -- "$dest.new.$$" &&
        mv -f -- "$dest.new.$$" "$dest"; then
        printf '%s\n' "$seed_id" >"$marker"
    else
        rm -f -- "$dest.new.$$" 2>/dev/null || true
        # No writable data directory: still start, but self-update will refuse
        # to replace the root-owned seed.
        exec "$seed" "$@"
    fi
fi

exec "$dest" "$@"
